<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd"> <HTML> <head>   <title>NORMA Oficial Mexicana NOM-003-ENER-2011, Eficiencia t&eacute;rmica de calentadores de agua para uso dom&eacute;stico y comercial</title>                            <style type='text/css'> .Sin_lista {font-family:Times Roman,serif,Times-Roman,Times;font-size:10.0pt;text-indent:0.0pt;margin-left:0.0pt;} .Titulo_2 {font-family:dialog,Verdana,Helvetica,Arial Unicode MS,Arial Black,Tahoma,sans-serif,system;font-size:9.0pt;margin-bottom:5.05pt;text-align:justify;text-indent:0.0pt;border-top: 0.75pt solid rgb(0,0,0);margin-left:0.0pt;padding-top:0.05pt;} .Encabezado {font-family:Times Roman,serif,Times-Roman,Times;font-size:12.0pt;text-indent:0.0pt;margin-left:0.0pt;} .Texto {font-family:dialog,Verdana,Helvetica,Arial Unicode MS,Arial Black,Tahoma,sans-serif,system;font-size:9.0pt;margin-bottom:5.05pt;text-align:justify;text-indent:14.4pt;margin-left:0.0pt;} .Fechas {font-family:Times Roman,serif,Times-Roman,Times;font-size:9.0pt;padding-bottom:0.05pt;margin-right:14.4pt;margin-bottom:0.0pt;text-align:justify;text-indent:0.0pt;margin-left:14.4pt;border-bottom: 0.75pt solid rgb(0,0,0);} .INCISO {font-family:dialog,Verdana,Helvetica,Arial Unicode MS,Arial Black,Tahoma,sans-serif,system;font-size:9.0pt;margin-bottom:5.05pt;text-align:justify;text-indent:-18.0pt;margin-left:54.0pt;} .ANOTACION {font-family:Times Roman,serif,Times-Roman,Times;font-size:9.0pt;margin-top:5.05pt;font-weight:bold;margin-bottom:5.05pt;text-align:center;text-indent:0.0pt;margin-left:0.0pt;} .listStyle_98914495_level_1 {font-family:Symbol;font-size:10.0pt;text-indent:-18.0pt;margin-left:50.4pt;} .ROMANOS {font-family:dialog,Verdana,Helvetica,Arial Unicode MS,Arial Black,Tahoma,sans-serif,system;font-size:9.0pt;margin-bottom:5.05pt;text-align:justify;text-indent:-21.6pt;margin-left:36.0pt;} .Texto_Car {font-family:dialog,Verdana,Helvetica,Arial Unicode MS,Arial Black,Tahoma,sans-serif,system;font-size:9.0pt;} .listStyle_2070612807_level_1 {font-family:Symbol;font-size:10.0pt;text-indent:-18.0pt;margin-left:72.0pt;} .Titulo_1 {font-family:Times Roman,serif,Times-Roman,Times;font-size:9.0pt;margin-top:6.0pt;padding-bottom:0.05pt;font-weight:bold;margin-bottom:0.0pt;text-align:justify;text-indent:0.0pt;margin-left:0.0pt;border-bottom: 1.5pt solid rgb(0,0,0);} .ROMANOS_Car {font-family:dialog,Verdana,Helvetica,Arial Unicode MS,Arial Black,Tahoma,sans-serif,system;font-size:9.0pt;} .Normal {font-family:Times Roman,serif,Times-Roman,Times;font-size:12.0pt;text-indent:0.0pt;margin-left:0.0pt;} </style> </head> <BODY> <div style= '' > <h1 style='border-bottom: 1.5pt solid rgb(0,0,0);margin-bottom:0.0pt;margin-left:0.0pt;margin-top:6.0pt;text-indent:0.0pt;' class='Titulo_1'> <span style='font-family:Times;'>NORMA</span><span style='font-family:Times;'> </span><span style='font-family:Times;'>Oficial Mexicana NOM-003-ENER-2011, Eficiencia t&eacute;rmica de calentadores de agua para uso dom&eacute;stico</span><span style='font-family:Times;'> </span><span style='font-family:Times;'>y comercial. L&iacute;mites, m&eacute;todo de prueba y etiquetado.</span></h1> <h2 style='border-top: 0.75pt solid rgb(0,0,0);margin-bottom:5.05pt;margin-left:0.0pt;text-indent:0.0pt;' class='Titulo_2'> <span style='font-family:Arial;'>Al margen un sello con el Escudo Nacional, que dice: Estados Unidos Mexicanos.- Secretar&iacute;a de Energ&iacute;a.</span></h2> <div style='font-size:8.0pt;margin-bottom:5.05pt;margin-left:0.0pt;text-indent:14.4pt;' class='Texto'> <span style='font-family:Arial;font-size:8.0pt;'>NORMA OFICIAL MEXICANA NOM-003-ENER-2011, EFICIENCIA TERMICA DE CALENTADORES DE AGUA PARA</span><span style='font-family:Arial;font-size:8.0pt;'> </span><span style='font-family:Arial;font-size:8.0pt;'>USO DOMESTICO Y COMERCIAL. LIMITES, METODO DE PRUEBA Y ETIQUETADO.</span></div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;text-indent:14.4pt;' class='Texto'> <span style='font-family:Arial;'>EMILIANO PEDRAZA HINOJOSA, Presidente del Comit&eacute; Consultivo Nacional de Normalizaci&oacute;n para la</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Preservaci&oacute;n y Uso Racional de los Recursos Energ&eacute;ticos (CCNNPURRE) y Director General de la Comisi&oacute;n</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Nacional para el Uso Eficiente de la Energ&iacute;a, con fundamento en los art&iacute;culos: 33 fracci&oacute;n X de la Ley</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Org&aacute;nica de la Administraci&oacute;n P&uacute;blica Federal; 1, 6, 7 fracci&oacute;n VII, 10, 11 fracciones IV y V y quinto transitorio</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>de la Ley para el Aprovechamiento Sustentable de la Energ&iacute;a, 38 fracci&oacute;n II, 40 fracciones I, X y XII, 41, 44,</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>45, 46, 47 y 51 de la Ley Federal sobre Metrolog&iacute;a y Normalizaci&oacute;n; 28, 33 y 34 del Reglamento de la Ley</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Federal sobre Metrolog&iacute;a y Normalizaci&oacute;n; 3 fracci&oacute;n VI inciso c), 33, 34 fracciones XIX, XX, XXII, XXIII y XXV</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>y 40 del Reglamento Interior de la Secretar&iacute;a de Energ&iacute;a; expide la siguiente:</span></div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;margin-top:5.05pt;text-indent:0.0pt;white-space:;' class='ANOTACION'> <span style='font-family:Times;'>NORMA OFICIAL MEXICANA NOM-003-ENER-2011, EFICIENCIA T</span><span style='font-family:Times;'>E</span><span style='font-family:Times;'>RMICA DE CALENTADORES DE</span><br> <span style='font-family:Times;'>AGUA P</span><span style='font-family:Times;'>ARA USO DOMESTICO Y COMERCIAL. </span><span style='font-family:Times;'>L</span><span style='font-family:Times;'>I</span><span style='font-family:Times;'>MITES, M</span><span style='font-family:Times;'>ETODO DE PRUEBA Y ETIQUETADO</span><br> </div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;margin-top:5.05pt;text-indent:0.0pt;white-space:;' class='ANOTACION'> <span style='font-family:Times;'>CONSIDERANDO</span><br> </div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;text-indent:14.4pt;' class='Texto'> <span style='font-family:Arial;'>Que la Ley Org&aacute;nica de la Administraci&oacute;n P&uacute;blica Federal, define las facultades de la Secretar&iacute;a de</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Energ&iacute;a, entre las que se encuentra la de expedir normas oficiales mexicanas que promueven la eficiencia del</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>sector energ&eacute;tico;</span></div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;text-indent:14.4pt;' class='Texto'> <span style='font-family:Arial;'>Que la Ley Federal sobre Metrolog&iacute;a y Normalizaci&oacute;n se&ntilde;ala como una de las finalidades de las normas</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>oficiales mexicanas el establecimiento de criterios y/o especificaciones que promuevan el mejoramiento del</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>medio ambiente, la preservaci&oacute;n de los recursos naturales y salvaguardar la seguridad al usuario;</span></div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;text-indent:14.4pt;' class='Texto'> <span style='font-family:Arial;'>Que habi&eacute;ndose cumplido el procedimiento establecido en la Ley Federal sobre Metrolog&iacute;a y</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Normalizaci&oacute;n para la elaboraci&oacute;n de proyectos de normas oficiales mexicanas, el Presidente del Comit&eacute;</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Consultivo Nacional de Normalizaci&oacute;n para la Preservaci&oacute;n y Uso Racional de los Recursos Energ&eacute;ticos,</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>orden&oacute; la publicaci&oacute;n del Proyecto de Norma Oficial Mexicana PROY-NOM-003-ENER-2010, Eficiencia</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>t&eacute;rmica de calentadores de agua para uso dom&eacute;stico y comercial. L&iacute;mites, m&eacute;todo de prueba y etiquetado; lo</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>que se realiz&oacute; en el Diario Oficial de la Federaci&oacute;n el 1 de febrero de  2011, con el objeto de que los</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>interesados presentaran sus comentarios al citado Comit&eacute; Consultivo que lo propuso;</span></div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;text-indent:14.4pt;' class='Texto'> <span style='font-family:Arial;'>Que durante el plazo de 60 d&iacute;as naturales contados a partir de la fecha de publicaci&oacute;n de dicho proyecto</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>de Norma Oficial Mexicana, la Manifestaci&oacute;n de Impacto Regulatorio a que se refiere el art&iacute;culo 45 de la Ley</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Federal sobre Metrolog&iacute;a y Normalizaci&oacute;n estuvo a disposici&oacute;n del p&uacute;blico en general para su consulta; y que</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>dentro del mismo plazo, los interesados presentaron comentarios sobre el contenido del citado proyecto de</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Norma Oficial Mexicana, mismos que fueron analizados por el Comit&eacute;, realiz&aacute;ndose las modificaciones</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>conducentes al proyecto de NOM. Las respuestas a los comentarios recibidos fueron publicadas en el Diario</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Oficial de la Federaci&oacute;n el 21 de julio de 2011;</span></div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;text-indent:14.4pt;' class='Texto'> <span style='font-family:Arial;'>Que la Ley Federal sobre Metrolog&iacute;a y Normalizaci&oacute;n establece que las normas oficiales mexicanas se</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>constituyen como el instrumento id&oacute;neo para la prosecuci&oacute;n de estos objetivos, se expide la siguiente Norma</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Oficial Mexicana NOM-003-ENER-2011, Eficiencia t&eacute;rmica de calentadores de agua para uso dom&eacute;stico y</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>comercial. L&iacute;mites, m&eacute;todo de prueba y etiquetado.</span></div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;text-indent:14.4pt;' class='Texto'> <span style='font-family:Arial;'>Sufragio Efectivo. No Reelecci&oacute;n.</span></div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;text-indent:14.4pt;' class='Texto'> &nbsp;</div>  <div style='margin-bottom:5.05pt;margin-left:0.0pt;page-break-before:avoid;text-indent:14.4pt;' class='Texto'> <span style='font-family:Arial;'>M&eacute;xico, D.F., a 5</span><span style='font-family:Arial;font-weight:bold;'> </span><span style='font-family:Arial;'>de agosto de 2011.</span><span style='font-family:Arial;'>-  El </span><span style='font-family:Arial;'>Presidente del Comit&eacute; Consultivo Nacional de Normalizaci&oacute;n</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>para la Preservaci&oacute;n y Uso Racional de los Recursos Energ&eacute;ticos (CCNNPURRE)</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>y Director General de la</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Comisi&oacute;n Nacional para el Uso Eficiente de la Energ&iacute;a</span><span style='font-family:Arial;'>, </span><span style='font-family:Arial;font-weight:bold;'>Emiliano Pedraza Hinojosa</span><span style='font-family:Arial;'>.- R&uacute;brica.</span></div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;margin-top:5.05pt;text-indent:0.0pt;white-space:;' class='ANOTACION'> <span style='font-family:Times;'>NOM-003-ENER-2011</span><br> </div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;margin-top:5.05pt;text-indent:0.0pt;white-space:;' class='ANOTACION'> <span style='font-family:Times;'>EFICIENCIA T</span><span style='font-family:Times;'>E</span><span style='font-family:Times;'>RMICA DE CALENTADORES DE AGUA PA</span><span style='font-family:Times;'>RA USO DOMESTICO Y COMERCIAL.</span><br> <span style='font-family:Times;'>LI</span><span style='font-family:Times;'>MITES</span><span style='font-family:Times;'>, METODO DE PRUEBA Y ETIQUETADO</span><br> </div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;margin-top:5.05pt;text-indent:0.0pt;white-space:;' class='ANOTACION'> <span style='font-family:Times;'>PREFACIO</span><br> </div> <div style='margin-bottom:5.05pt;margin-left:0.0pt;text-indent:14.4pt;' class='Texto'> <span style='font-family:Arial;'>La presente norma fu</span><span style='font-family:Arial;'>e elaborada</span><span style='font-family:Arial;'> por el Comit&eacute; Consultivo Nacional de Normalizaci&oacute;n para la</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>Preservaci&oacute;n y Uso Racional de los Recursos Energ&eacute;ticos (CCNNPURRE), con la colaboraci&oacute;n de los</span><span style='font-family:Arial;'> </span><span style='font-family:Arial;'>siguientes organismos, instituciones y empresas:</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Asociaci&oacute;n Nacional de  Fabricantes  de Aparatos Dom&eacute;sticos</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Asociaci&oacute;n Nacional de Normalizaci&oacute;n y Certificaci&oacute;n A.C.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Asesor&iacute;a y Pruebas a Equipo El&eacute;ctrico y Electr&oacute;nico S.A. de C.V.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Calentadores Magamex, S.A. de C.V.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Comercializadora Tektino, S.A. de C.V.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Consultor&iacute;a Global e Integral</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Desarrollo de Productos, S.A</span><span style='font-family:Arial;'>.</span><span style='font-family:Arial;'> de C.V.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Direcci&oacute;n General de Normas</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Calentadores de Ame</span><span style='font-family:Arial;'>rica. S. de R.L. de C.V.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Gilotronics, S.A. de C.V.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Hidroelectra, S.A. de C.V.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Industrias Lennox de M&eacute;xico S.A. de C.V.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Industrias Rheem, S.A</span><span style='font-family:Arial;'>.</span><span style='font-family:Arial;'> de C.V.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>Industrias T&eacute;cnicas Mexicanas, S.A. de C.V.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt;margin-left:0.0pt;'>&#183;</span><span style='font-family:Arial;font-size:10pt;'>&nbsp;&nbsp;&nbsp;</span><span style='font-family:Arial;'>IUSA, S.A. de C.V.</span></div> <div style='margin-bottom:5.05pt;margin-left:36.0pt;text-indent:-21.6pt;' class='ROMANOS'> <span class='listStyle_98914495_level_1' style='font-family:Symbol;font-size:10.0pt